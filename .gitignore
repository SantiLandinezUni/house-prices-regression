# --- virtual environment ---
.venv/
venv/
env/

# --- Python bytecode ---
__pycache__/
*.py[cod]
*.egg-info/

# --- Jupyter ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# --- data (Kaggle competition data is not ours to redistribute) ---
data/**
!data/
!data/raw/
!data/processed/
!data/**/.gitkeep

# --- trained model artefacts (large, regenerable) ---
models/*
!models/.gitkeep

# --- macOS ---
.DS_Store

# --- VS Code (keep shared settings, ignore per-machine state) ---
.vscode/*
!.vscode/settings.json
.backups/

# --- submission zip (duplicates report, notebook and csv) ---
*.zip
